# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Local agent / editor state (never commit) — except the skills, which are
# project documentation an agent reads before touching this codebase. A
# directory exclusion cannot be undone by a negation on its children, so the
# pattern excludes the CONTENTS and re-includes the one tracked subtree.
.claude/*
!.claude/skills/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Flutter golden mismatch dumps (local only; never commit)
/test/failures/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# build_macos.sh artifacts (throwaway vendored SDK + packaged app)
/.flutter-sdk/
/RemoteMagicGit-macos.zip
/.venv-icons/

# TOMBSTONE — nothing writes this any more (MADR 0042). The build used to
# strip Release.entitlements in place and back it up here while it did; that
# shipped stripped to git three times, so build_macos.sh now selects between
# TWO tracked files (Release.entitlements / Release-unsigned.entitlements) via
# an xcconfig variable instead, and never modifies either. The ignore rule
# stays so a stray copy left by an older checkout of build_macos.sh can never
# become committable.
/macos/Runner/Release.entitlements.bak

# Per-machine build selection: build_macos.sh writes this on every run to point
# MG_RELEASE_ENTITLEMENTS at the signed or the ad-hoc entitlements. It is local
# build configuration, never shared — see Configs/AppInfo.xcconfig.
/macos/Runner/Configs/Local.xcconfig

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
