// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = Magic Git

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = com.example.remoteMagicGit

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 Why Not? All rights reserved.

// Which entitlements the Release configuration signs with.
//
// `build_macos.sh` writes Configs/Local.xcconfig (gitignored) on every run to
// select the signed or the ad-hoc pair. With no such file present this resolves
// to the committed, sandboxed entitlements, so a plain `flutter build macos` or
// a build from Xcode.app is unchanged — `#include?` is an OPTIONAL include and
// is silently skipped when the file is absent.
//
// The point of the indirection is that nothing rewrites the entitlements file
// itself. It used to be stripped in place while Xcode was signing from it
// (MADR 0042).
MG_RELEASE_ENTITLEMENTS = Runner/Release.entitlements

// Which entitlements the Debug and Profile configurations sign with (MADR 0053
// Amendment 0053.2). The default is the committed DebugProfile.entitlements, so
// every ordinary debug build is unchanged. `xcodebuild test` on a machine with
// no development team passes
//   MG_DEBUG_ENTITLEMENTS=Runner/DebugProfile-unsigned.entitlements
// on its command line: the same file minus keychain-access-groups, which needs a
// certificate. Nothing edits either entitlements file in place.
MG_DEBUG_ENTITLEMENTS = Runner/DebugProfile.entitlements
#include? "Local.xcconfig"
